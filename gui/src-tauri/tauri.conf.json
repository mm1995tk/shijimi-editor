{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shijimi-editor",
  "version": "0.0.0",
  "identifier": "dev.mm1995tk.shijimi-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "shijimi-editor", "width": 1200, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
