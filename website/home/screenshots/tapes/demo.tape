Output demo.mp4
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 15
Set Width 1440
Set Height 860
Set Padding 0
Set Theme "GitHub Dark"
Set TypingSpeed 60ms

Hide
Type 'cd "$DEMO" && clear && shj' Enter
Sleep 4s
Show
Type " f"
Sleep 500ms
Type "main.go"
Sleep 500ms
Enter
Sleep 3s
Type ":14"
Enter
Sleep 500ms
Type "o"
Sleep 500ms
Type "s.Ad"
Sleep 1500ms
Enter
Type '("Ship it")'
Sleep 500ms
Escape
Type ":w"
Enter
Sleep 1500ms
Type " ?"
Sleep 500ms
Type "toggle the terminal"
Sleep 500ms
Enter
Sleep 1500ms
Type "go run ."
Enter
Sleep 5s
Type "exit"
Enter
Sleep 1s
Type " G"
Sleep 2s
Escape
Sleep 300ms
Type " f"
Sleep 500ms
Type "store"
Sleep 500ms
Enter
Sleep 2s
Type "20j"
Sleep 3s
Type " G"
Sleep 1s
Type " f"
Sleep 500ms
Type "README"
Sleep 500ms
Enter
Sleep 1s
Type " m"
Sleep 4s
